# Single-User-Betrieb ohne Keycloak: kopieren nach .env.noauth und ausfüllen.
# Nutzung: docker compose -f docker-compose.noauth.yml --env-file .env.noauth up -d
# Public GHCR-Image oder das selbst gebaute aus der eigenen Registry.
SMIERX_QUEUE_IMAGE=ghcr.io/smierx/smierx-queue:latest
POSTGRES_PASSWORD=<zufallspasswort>
APP_PORT=8010
# Ohne Login schützt nur die Erreichbarkeit: Default bindet auf 127.0.0.1.
# Nur aufmachen wenn ein Reverse-Proxy o.ä. davor sitzt.
#APP_BIND=0.0.0.0
