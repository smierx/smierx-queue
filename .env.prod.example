# Kopieren nach .env.prod und ausfüllen.
SMIERX_QUEUE_IMAGE=ghcr.io/smierx/smierx-queue:latest
POSTGRES_PASSWORD=<sicheres-passwort>
APP_PORT=8010

# Keycloak auf dem Homeserver. Issuer = wie ihn der Browser erreicht.
OIDC_ISSUER=https://keycloak.example.home/realms/smierx
FRONTEND_KEYCLOAK_URL=https://keycloak.example.home
# Nur setzen wenn der App-Container den Issuer-Host nicht auflösen kann:
# OIDC_JWKS_URL=http://keycloak:8080/realms/smierx/protocol/openid-connect/certs
