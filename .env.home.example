# Homeserver: kopieren nach .env.prod und ausfüllen.
# Nutzung: docker compose -f docker-compose.home.yml --env-file .env.prod up -d
SMIERX_QUEUE_IMAGE=ghcr.io/smierx/smierx-queue:latest
# Passwort des DB-Users smierx_queue in der zentralen Postgres
# (angelegt nach "Setup – Postgres Service-DB").
POSTGRES_PASSWORD=<passwort-aus-secrets>
APP_PORT=8010

OIDC_ISSUER=https://auth.smierx.com/realms/smierx
FRONTEND_KEYCLOAK_URL=https://auth.smierx.com
